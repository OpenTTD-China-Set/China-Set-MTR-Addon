//Begin LOK2000



// Graphics

// Purchase Menu
spriteset (spriteset_taipo_belle_purchase_original, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("dieselloco", "taipo-belle")
}

// Vehicle
spriteset (spriteset_taipo_belle, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_reversed ("dieselloco", "taipo-belle")
}

switch (FEAT_TRAINS, SELF, switch_taipo_belle_capacity, position_in_articulated_veh % 3) {
    1: return 80;
    return 0;
}

switch (FEAT_TRAINS, SELF, switch_taipo_belle_articulated_part, extra_callback_info1) {
    1..2: return taipo_belle;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}


switch (FEAT_TRAINS, SELF, switch_taipo_belle_graphics, position_in_articulated_veh % 3) {
    1: spriteset_taipo_belle;
    empty_sprites;
}


item (FEAT_TRAINS, taipo_belle) {
    property {
        // Menu
        name:                           string(STR_NAME_TAIPO_BELLE);
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT);
        engine_class:                   ENGINE_CLASS_ELECTRIC;

        // Availability
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(1936,01,01);
        model_life:                     30;
        retire_early:                   15;
        vehicle_life:                   15;
        track_type:                     SACN;

        // Cargo
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes:   0;
        cargo_allow_refit:              [];
        cargo_disallow_refit:           [];
        refit_cost:                     0;
        default_cargo_type:             PASS;
        ai_special_flag:                AI_FLAG_PASSENGER;
        cargo_capacity:                 1;
        loading_speed:                  8 << param_loading_speed;
        cargo_age_period:               192 << param_cargo_decay;

        // Stats
        speed:                          90 km/h;
        power:                          112 kW;
        weight:                         46 ton;
        tractive_effort_coefficient:    0.08;
        cost_factor:                    45;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        running_cost_factor:            104;
        reliability_decay:              20;
    }
    graphics {
        // Menu
        additional_text:                string(STR_DESC_5, string(STR_DIESEL),  string(STR_USEDLINE_KTT), string(STR_RELDEC_HIGH, 20));
        can_attach_wagon:               locowagon;
        // Graphics
        default:                        switch_taipo_belle_graphics;
        purchase:                       spriteset_taipo_belle_purchase_original;
        articulated_part:               switch_taipo_belle_articulated_part;

        // Stats
        length:                         switch_length_2_4_2;
        cargo_capacity:                 0;
        cost_factor:                    45;
        running_cost_factor:            25 * runningcostfactor();
        purchase_running_cost_factor:   100;
        purchase_cargo_capacity:        0;
        bitmask_vehicle_info:           0;

    }
}

// End LOK2000